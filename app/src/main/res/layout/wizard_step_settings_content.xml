<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime-inflated wizard settings; view count is inherent to the step. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="TooManyViews">
        <!-- Analysis mode: one setting, or a parameter sweep. No card: the
             page is one flat list, sections split by dividers. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rgAnalysisMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:checkedButton="@+id/rbModeSingle"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbModeSingle"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_single" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbModeSweep"
                    style="@style/Widget.Semper.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_sweep" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <ImageButton
                android:id="@+id/btnSweepInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                app:tint="@color/viewer_chrome_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@color/surface_outline" />

        <!-- Region of interest: the reference with the region drawn on it -->
        <LinearLayout
            android:id="@+id/roiRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_12">

            <com.sempermechanics.semper.ui.analysis.sweep.LineCutPreviewView
                android:id="@+id/roiThumb"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:contentDescription="@string/region_of_interest" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_of_interest"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Semper.Numeric"
                    tools:text="1100 × 800 of 1200 × 900 px" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDefineRoi"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_edit" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_outline" />

        <!-- Correlation parameters (single setting). Id kept from the card it
             replaced: the coach mark and Paste scroll to it. -->
        <LinearLayout
            android:id="@+id/advancedParamsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/param_section_correlation"
                    android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                    android:textColor="@color/viewer_chrome_text" />

                <ImageButton
                    android:id="@+id/btnPasteParams"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_paste_params"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_content_paste"
                    android:visibility="gone"
                    app:tint="@color/sky_primary"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnAdvancedReset"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_reset"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/viewer_chrome_text" />
            </LinearLayout>

            <!-- Subset size, with the measured speckle beside it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subset_size"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSubsetInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeckle"
                    style="@style/Widget.Semper.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:checkable="false"
                    android:clickable="false"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:chipMinHeight="24dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="Speckle 4.3 px"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/etSubsetValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="@string/subset_size"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="41" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/scale_unit_px"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- The recommended band is drawn behind the track (SubsetBand). -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSubsetSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:value="41"
                android:valueFrom="15"
                android:valueTo="121" />

            <!-- What the shaded band means; gone until the speckle is measured. -->
            <TextView
                android:id="@+id/tvSpeckleReadout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Semper.Caption"
                android:visibility="gone"
                tools:text="Set to 31 px · shaded: 25 px and up hold enough speckle"
                tools:visibility="visible" />

            <!-- The subset is too small to span three speckles. Its fix is the
                 slider above, so it clears in place as the slider moves. -->
            <include
                android:id="@+id/speckleSpanWarnRow"
                layout="@layout/view_warn_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />

            <!-- Step: the grid pitch, with the points it gives and the overlap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_step"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnStepInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/etStepValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/step_size_density"
                    android:gravity="end"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/scale_unit_px"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStepSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="5"
                android:valueFrom="1"
                android:valueTo="30" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStepPoints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Semper.Caption"
                    tools:text="8,800 points in the region" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overlap"
                    android:textAppearance="@style/TextAppearance.Semper.Caption" />

                <EditText
                    android:id="@+id/etOverlapValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/subset_overlap"
                    android:gravity="end"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="4"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="0.80" />

                <ImageButton
                    android:id="@+id/btnOverlapInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderOverlap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:stepSize="1"
                android:value="88"
                android:valueFrom="50"
                android:valueTo="99"
                android:visibility="gone" />

            <!-- Strain window, in data points; the caption gives the VSG in px -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strain_window"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnStrainInfo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/info"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info_min"
                    app:tint="@color/viewer_chrome_muted" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/etStrainValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="@string/strain_window"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"
                    tools:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/strain_window_unit_points"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- In data points (SweepStudy.MIN_WINDOW_POINTS..MAX_WINDOW_POINTS). -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStrainWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="2"
                android:value="5"
                android:valueFrom="3"
                android:valueTo="31" />

            <TextView
                android:id="@+id/tvStrainVsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Semper.Caption"
                tools:text="Fits a plane over 21 px (VSG)" />

            <!-- Sub-pixel interpolation kernel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/param_interpolation"
                    android:textColor="@color/viewer_chrome_text"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilInterpolator"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="168dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/sub_pixel_interpolation_kernel">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddInterpolator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="14sp"
                        tools:text="4×4 Bicubic" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Sweep settings (sweep mode). Id kept from the card it replaced. -->
        <LinearLayout
            android:id="@+id/sweepSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

                <LinearLayout
                    android:id="@+id/sweepSettingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sweep_settings"
                        android:textAppearance="@style/TextAppearance.Semper.SectionHeader"
                        android:textColor="@color/viewer_chrome_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sweepBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="visible">

                    <!-- Subset size range: min text | range slider | max text -->
                    <LinearLayout
                        android:id="@+id/subsetRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subset_range"
                            android:textColor="@color/viewer_chrome_text"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSubsetRangeInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etSubsetMinValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_min"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="41" />

                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/rangeSubset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="2"
                            android:valueFrom="15"
                            android:valueTo="121"
                            app:values="@array/subset_range_default" />

                        <EditText
                            android:id="@+id/etSubsetMaxValue"
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:hint="@string/subset_max"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/sky_primary"
                            android:textStyle="bold"
                            tools:text="61" />
                    </LinearLayout>
                    </LinearLayout>

                    <!-- Strain window range: titled and full-width, the
                         twin of the subset range above it. -->
                    <LinearLayout
                        android:id="@+id/strainWinRangeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/strain_win_range"
                                android:textColor="@color/viewer_chrome_text"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnVsgMaxInfo"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/info"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_info_min"
                                app:tint="@color/viewer_chrome_muted" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etStrainWinMinValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_min"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="3" />

                            <com.google.android.material.slider.RangeSlider
                                android:id="@+id/rangeStrainWin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:stepSize="2"
                                android:valueFrom="3"
                                android:valueTo="31"
                                app:values="@array/strain_window_range_default" />

                            <EditText
                                android:id="@+id/etStrainWinMaxValue"
                                android:layout_width="46dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:hint="@string/strain_win_max"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:textColor="@color/sky_primary"
                                android:textStyle="bold"
                                tools:text="11" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <ImageButton
                            android:id="@+id/btnStepDepthInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStepDepth"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/step_depth"
                            app:boxStrokeColor="@color/input_box_stroke"
                            app:hintTextColor="@color/viewer_chrome_muted"
                            app:prefixText="@string/step_depth_prefix">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStepDepthValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSweepOverlap"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/overlap"
                            app:boxStrokeColor="@color/input_box_stroke"
                            app:hintTextColor="@color/viewer_chrome_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSweepOverlapValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:maxLength="4"
                                android:textColor="@color/viewer_chrome_text"
                                tools:text="0.67" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnSweepOverlapInfo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/info"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_info_min"
                            app:tint="@color/viewer_chrome_muted" />
                    </LinearLayout>
                    <!-- Multi-frame only: collapsed summary (preview while picking) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickSweepFrame"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/sky_primary"
                        android:visibility="gone"
                        tools:text="img.png · Frame 3 of 12"
                        tools:visibility="visible" />
                </LinearLayout>
        </LinearLayout>


        <!-- Results chrome (Compute is in bottomNav) -->

        <include
            android:id="@+id/frameSizeWarnRow"
            layout="@layout/view_warn_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Status after Compute; ⓘ stays after an engine-failure dialog so FAQ
             is still reachable once Why? is gone. -->
        <LinearLayout
            android:id="@+id/runStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvStaticResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result"
                android:textAlignment="center"
                android:textColor="@color/viewer_chrome_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEngineFailFaq"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/warn_faq_desc"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_min"
                android:visibility="gone"
                app:tint="@color/semantic_danger"
                tools:visibility="visible" />
        </LinearLayout>
</merge>
