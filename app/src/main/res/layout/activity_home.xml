<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface" tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title and gear on one line; the account chips sit under it and
             show only when there is something to say (HomeQuotaCard). -->
        <LinearLayout
            android:id="@+id/homeTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnHomeSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_settings"
                    android:src="@drawable/ic_settings_gear"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Shown from 80% of the analysis ceiling (HomeQuotaCard). -->
            <TextView
                android:id="@+id/tvHomeQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_warn_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="820 / 999 analyses used" />

            <!-- License expiry / grace notice. Separate from tvHomeQuota
                 because a licensed account always has a known quota, so it
                 would never reach that view's unknown-quota hint branch. -->
            <TextView
                android:id="@+id/tvHomeLicense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_warn_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="License expires in 9 days" />
        </LinearLayout>

        <!-- Contextual bar: replaces the title row while rows are selected, and
             deliberately mirrors its geometry — same 20dp/14dp padding, same
             surface, same 20sp bold heading, same 48dp text_primary icon
             buttons — so the screen keeps its shape when selection starts.
             Rename only makes sense for one row, so it hides above a single
             selection (see HomeActivity.updateSelectionBar). -->
        <LinearLayout
            android:id="@+id/homeSelectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <!-- Row 1 matches the title row exactly: 48dp buttons, 20sp bold
                 heading, every glyph on the same 32dp inset as the settings
                 gear, so nothing shifts when the two bars swap. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSelectionClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/selection_clear"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvSelectionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="2 selected" />

                <ImageButton
                    android:id="@+id/btnSelectionRename"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_rename"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_primary" />

                <!-- Shown only when every selected row is cloud-only. -->
                <ImageButton
                    android:id="@+id/btnSelectionRestore"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/restore_action"
                    android:src="@drawable/ic_cloud_download"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnSelectionDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_delete"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Row 2: the 12dp start margin puts the tick box on the same
                 32dp inset as the ✕ glyph above it. minWidth/minHeight 0 strips
                 the stock 48dp minimum, which would otherwise pad the box away
                 from that alignment. -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbSelectionAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/selection_select_all"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Backups this phone has no row for (another phone, a reinstall).
             A card above the flat rows; shown only when there is something
             to offer (HomeActivity). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeCloudBackups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_muted"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvCloudBackups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/ic_cloud_download"
                    app:drawableTint="@color/sky_primary"
                    tools:text="4 analyses in your cloud backup aren't on this phone." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloudBackupsHide"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_backups_hide"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloudBackupsRestore"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/restore_action"
                        android:textAllCaps="false"
                        android:textColor="@color/sky_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pull down to re-check cloud backup state on demand. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sessionList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="96dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name_short"
            android:forceDarkAllowed="false"
            tools:targetApi="29"
            android:scaleType="fitCenter"
            android:src="@drawable/semper_mark_s" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxWidth="260dp"
            android:text="@string/home_empty_body"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyRestore"
            style="@style/Widget.Semper.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_empty_start" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/fabNewAnalysis"
        android:layout_width="96dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_fab_rect"
        android:contentDescription="@string/home_new_analysis"
        android:elevation="6dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_new_analysis"
        app:tint="@color/text_on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
